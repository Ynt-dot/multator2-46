# =============================================================================
# МУЛЬТАТОР 2 — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# Get these from: https://supabase.com/dashboard → project → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Sentry — error monitoring (optional)
# Get DSN from: https://sentry.io → project → Settings → Client Keys
# SENTRY_ORG and SENTRY_PROJECT are used at build time by @sentry/nextjs.
# Leave blank to disable Sentry entirely.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Auth callback redirect (development only)
# Override the OAuth redirect URL when running locally.
# In production this is derived from the request Host header automatically.
# Example: http://localhost:3000/auth/callback
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# -----------------------------------------------------------------------------
# Upstash Redis — rate limiting (required on Vercel / multi-instance deployments)
# Get these from: https://console.upstash.com → Redis → REST API
# Without these, rate limiting falls back to in-memory (single-instance only).
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Auto-set by the runtime — do not configure manually
# NODE_ENV      set by Next.js (development | production | test)
# NEXT_RUNTIME  set by Next.js (nodejs | edge)
# CI            set by CI providers (GitHub Actions, Vercel, etc.)
# -----------------------------------------------------------------------------
